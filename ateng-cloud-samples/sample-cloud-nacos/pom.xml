<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-cloud-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>sample-cloud-nacos</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-cloud Nacos 注册与动态配置中心自验场景工程 (100% 离线自洽)</description>

    <dependencies>
        <!-- ateng-cloud-nacos 基础设施 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-nacos</artifactId>
        </dependency>

        <!-- Web 运行时环境 (基于 ateng-boot-web) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- 配置密文解密组件 (基于 ateng-boot-encrypt) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-encrypt</artifactId>
        </dependency>

        <!-- Spring Boot Actuator 监控与端点支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
</project>
