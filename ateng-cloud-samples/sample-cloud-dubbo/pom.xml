<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-cloud-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>sample-cloud-dubbo</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-cloud Dubbo 高性能 RPC 通信自验场景工程 (100% 离线自洽)</description>

    <dependencies>
        <!-- ateng-cloud-dubbo 基础设施 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-dubbo</artifactId>
        </dependency>

        <!-- Web 运行时环境 (基于 ateng-boot-web 提供标准 Spring 上下文与序列化底座) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator 监控度量支持 (激活 Micrometer Observation 统一观测底座) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Sa-Token 内部受信凭据测试套件 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Test 测试套件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Seata 事务上下文测试套件 (用于端到端验证 Seata XID 跨 RPC 穿透) -->
        <dependency>
            <groupId>org.apache.seata</groupId>
            <artifactId>seata-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Dubbo Nacos 真实注册中心测试驱动适配 (激活 local profile 实测支持) -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-registry-nacos</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
