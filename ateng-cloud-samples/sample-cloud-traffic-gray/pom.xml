<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-cloud-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>sample-cloud-traffic-gray</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-cloud 全链路流量染色与金丝雀灰度自验场景工程 (100% 离线自洽沙箱拓扑)</description>

    <dependencies>
        <!-- ateng-cloud-traffic 核心依赖 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-traffic</artifactId>
        </dependency>

        <!-- ateng-cloud-feign 微服务声明式调用 (用于验证 Feign 灰度与上下文穿透) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-feign</artifactId>
        </dependency>

        <!-- Web 运行时环境 (基于 ateng-boot-web) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-boot-web</artifactId>
        </dependency>

        <!-- Spring Cloud LoadBalancer 负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ateng-cloud-nacos 动态配置中心与服务注册 (离线 Mock 测试支持) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-nacos</artifactId>
        </dependency>

        <!-- Spring Boot Actuator 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 单元测试套件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
