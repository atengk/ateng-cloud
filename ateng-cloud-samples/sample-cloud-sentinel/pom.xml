<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-cloud-samples</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>sample-cloud-sentinel</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-cloud Sentinel 流量防卫与熔断降级端到端自验集成样例 (离线自洽沙箱)</description>

    <dependencies>
        <!-- ateng-cloud-sentinel 本地被测微服务 Starter -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-sentinel</artifactId>
        </dependency>

        <!-- Spring Boot Web Starter (提供 Servlet / Spring MVC 运行时) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Cloud OpenFeign Starter (用于声明式 Feign 熔断自测) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Spring Boot Test 离线测试套件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
