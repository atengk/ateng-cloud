<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.atengk</groupId>
        <artifactId>ateng-cloud</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ateng-cloud-all</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>ateng-cloud 微服务全能聚合全家桶 (一键引入 nacos、feign、dubbo 等通用微服务骨干构件)</description>

    <dependencies>
        <!-- Nacos 服务注册与动态配置中心 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-nacos</artifactId>
        </dependency>

        <!-- OpenFeign 声明式 HTTP 通信与治理增强 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-feign</artifactId>
        </dependency>

        <!-- Apache Dubbo 3.3 高性能 RPC 通信与治理增强 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-dubbo</artifactId>
        </dependency>

        <!-- Sentinel 流量防卫、熔断降级与规则持久化底座 -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-sentinel</artifactId>
        </dependency>

        <!-- Spring Cloud Gateway 响应式微服务网关底座 (可选依赖，遵循 Reactive vs Servlet 物理隔离铁律) -->
        <dependency>
            <groupId>io.github.atengk</groupId>
            <artifactId>ateng-cloud-gateway</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
